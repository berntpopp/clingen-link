# Example Docker environment for clingen-link.
# Copy to .env.docker and edit for Compose / Nginx Proxy Manager deployments.
#
#   cp .env.docker.example .env.docker

# ---- Local published host port (base + dev compose) ----
# Container-internal port stays 8000; override the host-side port here.
CLINGEN_LINK_HOST_PORT=8000

# ---- Logging ----
LOG_LEVEL_API=INFO

# ---- Caching ----
CLINGEN_CACHE_SIZE=2000
CLINGEN_CACHE_TTL_MINUTES=120

# ---- CORS ----
CLINGEN_CORS_ORIGINS=*

# ---- Nginx Proxy Manager (docker-compose.npm.yml) ----
# External NPM network the container joins for reverse-proxy routing.
NPM_SHARED_NETWORK_NAME=npm_default

# ---- NPM resource limits (optional) ----
CLINGEN_API_MEMORY_LIMIT=1g
CLINGEN_API_CPU_LIMIT=1.0
