# Example environment overrides for clingen-link.
# Copy to .env and adjust as needed. All settings use the CLINGEN_LINK_ prefix.

# uv performance optimization for WSL2/NTFS
# UV_LINK_MODE=copy
# UV_CACHE_DIR=/tmp/uv-cache

# ---- ClinGen upstream endpoints (ETL sources + live drill-down) ----
# CLINGEN_LINK_VALIDITY_API_BASE=https://search.clinicalgenome.org/api
# CLINGEN_LINK_DOSAGE_FTP_BASE=https://ftp.clinicalgenome.org
# CLINGEN_LINK_ACTIONABILITY_API_BASE=https://actionability.clinicalgenome.org/ac
# CLINGEN_LINK_EREPO_API_BASE=https://erepo.clinicalgenome.org/evrepo

# ---- Snapshot ----
# Read-only SQLite snapshot location (defaults to the bundled .zst in the package).
# CLINGEN_LINK_SNAPSHOT_PATH=clingen_link/data/clingen.sqlite.zst

# ---- Live client resilience ----
# Max concurrent in-flight upstream requests; bounds burst pressure.
# CLINGEN_LINK_MAX_CONCURRENCY=5
# Per-request upstream timeout (seconds).
# CLINGEN_LINK_REQUEST_TIMEOUT_S=30
# Max seconds a request waits for a concurrency slot before returning fast,
# retryable backpressure (rate_limited) instead of hanging.
# CLINGEN_LINK_QUEUE_WAIT_TIMEOUT_S=20

# ---- Caching ----
# CLINGEN_LINK_CACHE_SIZE=512
# CLINGEN_LINK_CACHE_TTL_MINUTES=60
# ERepo live drill-down is keyed to the ERepo `news` version and changes
# infrequently, so it gets a longer default TTL than the general cache.
# CLINGEN_LINK_EREPO_CACHE_TTL_MINUTES=720

# ---- Transport (Streamable HTTP only) ----
# CLINGEN_LINK_MCP_TRANSPORT=unified   # unified | http
# CLINGEN_LINK_MCP_HOST=127.0.0.1
# CLINGEN_LINK_MCP_PORT=8000
# CLINGEN_LINK_MCP_PATH=/mcp
# CLINGEN_LINK_ALLOWED_HOSTS=["localhost","127.0.0.1","::1"]
# CLINGEN_LINK_ALLOWED_ORIGINS=[]

# ---- Logging ----
# CLINGEN_LINK_LOG_LEVEL=INFO
# CLINGEN_LINK_LOG_FORMAT=json           # json (prod) | console (dev)

# ---- Server ----
# CLINGEN_LINK_CORS_ORIGINS=*            # comma-separated CORS response origins
# CLINGEN_LINK_ENABLE_SWAGGER=true
# CLINGEN_LINK_ENABLE_MONITORING=true
# CLINGEN_LINK_GRACEFUL_SHUTDOWN_TIMEOUT=30
# CLINGEN_LINK_MAX_PAGE_SIZE=100
